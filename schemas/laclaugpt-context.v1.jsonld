{
  "@context": {
    "@version": 1.1,
    "laclaugpt": "https://w3id.org/laclaugpt/",
    "res": "https://w3id.org/laclaugpt/resource/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "oa": "http://www.w3.org/ns/oa#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "label": "skos:prefLabel",
    "project": {"@id": "laclaugpt:project", "@type": "@id"},
    "source": {"@id": "dcterms:source", "@type": "@id"},
    "generatedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "derivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id"},
    "evidence": {"@id": "laclaugpt:hasEvidence", "@type": "@id"},
    "actor": {"@id": "laclaugpt:actor", "@type": "@id"},
    "statement": {"@id": "laclaugpt:statement", "@type": "@id"},
    "concept": {"@id": "laclaugpt:concept", "@type": "@id"},
    "sourceNode": {"@id": "laclaugpt:sourceNode", "@type": "@id"},
    "targetNode": {"@id": "laclaugpt:targetNode", "@type": "@id"},
    "role": {"@id": "laclaugpt:role", "@type": "@id"},
    "confidence": {"@id": "laclaugpt:confidence", "@type": "xsd:decimal"},
    "reviewState": "laclaugpt:reviewState",
    "edgeType": "laclaugpt:edgeType",
    "directed": {"@id": "laclaugpt:directed", "@type": "xsd:boolean"},
    "weight": {"@id": "laclaugpt:weight", "@type": "xsd:decimal"},
    "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"},
    "language": "dcterms:language"
  }
}
