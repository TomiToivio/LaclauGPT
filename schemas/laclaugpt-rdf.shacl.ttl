@prefix laclaugpt: <https://w3id.org/laclaugpt/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

laclaugpt:ArticulationShape a sh:NodeShape ;
    sh:targetClass laclaugpt:Articulation ;
    sh:property [
        sh:path laclaugpt:articulates ;
        sh:minCount 2 ;
        sh:message "An articulation must connect at least two articulated resources."@en
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "An analytical articulation must retain generation provenance."@en
    ] ;
    sh:property [
        sh:path laclaugpt:reviewState ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ("PROVISIONAL" "ACCEPTED" "REJECTED" "REVISED" "CANONICAL" "SUPERSEDED")
    ] ;
    sh:property [
        sh:path laclaugpt:confidence ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1
    ] .

laclaugpt:DiscursiveRoleAssignmentShape a sh:NodeShape ;
    sh:targetClass laclaugpt:DiscursiveRoleAssignment ;
    sh:property [
        sh:path laclaugpt:concept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A discursive role assignment must identify the signifier/concept being assigned a role."@en
    ] ;
    sh:property [
        sh:path laclaugpt:role ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A discursive role assignment must identify its contextual role."@en
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "Theory-specific role assignments must retain analytical-run provenance."@en
    ] ;
    sh:property [
        sh:path laclaugpt:reviewState ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ("PROVISIONAL" "ACCEPTED" "REJECTED" "REVISED" "CANONICAL" "SUPERSEDED")
    ] ;
    sh:property [
        sh:path laclaugpt:confidence ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1
    ] .
